# Copy to starter/.env.op and edit. Standard way to load the hosted-endpoint
# credentials for this repo — full guide: docs/1password.md
#
# These are 1Password secret REFERENCES, not secrets. The 1Password CLI (`op`)
# resolves them when you launch a command through `op run`, so the real URL and
# key live only in your 1Password vault and in the launched process's memory —
# never in a file on disk.
#
#   cp starter/.env.op.example starter/.env.op
#   op run --env-file=starter/.env.op -- ./starter/scripts/run_baseline.sh regex-log
#
# Replace <your-item> with the exact item name from YOUR 1Password vault. Easiest:
# open the item, click the field's menu, choose "Copy Secret Reference", paste here.
# Quote any reference containing a space (e.g. the "base url" field).
LLM_BASE_URL="op://Employee/<your-item>/base url"
LLM_API_KEY="op://Employee/<your-item>/credential"

# Model id exactly as the server reports it at GET $LLM_BASE_URL/models (a wrong
# id gives 400 "Invalid model name"). The llm-gw01 gateway serves qwen3.8-27b
# (plus embedding/vision models); it does not serve the Qwen3.6-27B-FP8 checkpoint.
# Fine for development; confirm the model is approved before any submission run.
LLM_MODEL=qwen3.8-27b

# IMPORTANT: starter/.env must NOT also set LLM_BASE_URL / LLM_MODEL / LLM_API_KEY.
# The agent loads .env with override=True, so any active value there silently
# replaces what `op run` supplied. Non-secret tuning (LLM_MAX_TOKENS, AGENT_*)
# stays in starter/.env as usual.
