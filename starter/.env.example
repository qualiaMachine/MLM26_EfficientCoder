# Copy to .env and fill in. The agent reads these at runtime (via python-dotenv).

# Any OpenAI-compatible endpoint works. Examples:
#   Ollama (default):  http://localhost:11434/v1
#   vLLM:              http://localhost:8000/v1
#   Together AI:       https://api.together.xyz/v1
LLM_BASE_URL=http://localhost:11434/v1

# Model id as the endpoint knows it (e.g. `ollama list` names for Ollama).
LLM_MODEL=qwen2.5-coder:14b # adjust to 7B if you have limited memory (< 32 GB), but expect most tests to fail with small models

# Anything non-empty for local endpoints; real key for hosted APIs.
# Use a throwaway key for the hackathon — never your personal production key.
LLM_API_KEY=ollama

# ── Provided endpoint (UW–Madison participants — default) ──────────────────────
# Shared UW–Madison model gateway (BadgerBrain). Request a personal key via the
# access form linked in docs/uw_madison_endpoint.md; GlobalProtect VPN and a
# firewall entry for your NetID are required. Uncomment these four lines to use
# it — they sit below the Ollama values on purpose, so the later assignment wins
# and you don't have to touch the lines above. Details + etiquette: docs/uw_madison_endpoint.md
#LLM_BASE_URL=https://llm-gw01.doit.wisc.edu/v1
#LLM_MODEL=qwen3.8-27b
#LLM_API_KEY=<your gateway key>
#LLM_MAX_TOKENS=8192   # reasoning model — thinking tokens count against this. Too low and the
                       # model burns the whole budget mid-thought: every response comes back
                       # empty and the task times out. 4096 is not always enough; start at 8192.

# Optional tuning — all have sensible defaults in agent/llm.py and agent/agent.py;
# uncomment only what you want to change.
#LLM_TEMPERATURE=0.0
#LLM_MAX_TOKENS=2048
#AGENT_MAX_TURNS=100
#AGENT_COMMAND_TIMEOUT_SEC=60
